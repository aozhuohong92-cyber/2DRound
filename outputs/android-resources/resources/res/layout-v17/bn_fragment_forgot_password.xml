<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingBottom="14dp"
    android:layout_width="350dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/yh_iv_back"
        android:padding="12dp"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/yh_back"
        android:contentDescription="返回"/>
    <ImageView
        android:id="@+id/yh_iv_close"
        android:padding="12dp"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/yh_close"
        android:layout_alignParentRight="true"
        android:contentDescription="关闭"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/yh_light_black"
        android:gravity="center"
        android:id="@+id/yh_tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:text="忘记密码"
        android:layout_below="@+id/yh_iv_back"
        android:layout_alignTop="@+id/yh_iv_back"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/bn_rl_phone"
        android:background="@color/yh_background_gray"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="36dp"
        android:layout_marginRight="36dp"
        android:layout_below="@+id/yh_tv_hint">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/yh_black"
            android:id="@+id/bn_edt_phone"
            android:background="@null"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="请输入手机号"
            android:maxLines="1"
            android:layout_toLeftOf="@+id/bn_iv_un_clear"
            android:inputType="phone"
            android:textCursorDrawable="@drawable/yh_cursor_color"/>
        <ImageView
            android:id="@+id/bn_iv_un_clear"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/yh_edit_clear"
            android:layout_alignParentRight="true"
            android:contentDescription="清空手机"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/bn_ll_verify"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="36dp"
        android:layout_below="@+id/bn_rl_phone">
        <Button
            android:textColor="@color/yh_white"
            android:id="@+id/bn_btn_verify"
            android:background="@color/yh_blue"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="50dp"
            android:text="获取验证码"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            style="?android:attr/borderlessButtonStyle"/>
        <EditText
            android:textSize="16sp"
            android:textColor="@color/yh_black"
            android:id="@+id/bn_edt_verify"
            android:background="@color/yh_background_gray"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginRight="6dp"
            android:hint="请输入验证码"
            android:maxLines="1"
            android:layout_toLeftOf="@+id/bn_btn_verify"
            android:inputType="text"
            android:textCursorDrawable="@drawable/yh_cursor_color"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/bn_rl_password"
        android:background="@color/yh_background_gray"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="36dp"
        android:layout_below="@+id/bn_ll_verify">
        <EditText
            android:textSize="16sp"
            android:textColor="@color/yh_black"
            android:id="@+id/bn_edt_password"
            android:background="@null"
            android:padding="6dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="请输入密码"
            android:maxLines="1"
            android:layout_toLeftOf="@+id/bn_iv_pw_clear"
            android:inputType="textPassword"
            android:textCursorDrawable="@drawable/yh_cursor_color"/>
        <ImageView
            android:id="@+id/bn_iv_pw_clear"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/yh_edit_clear"
            android:layout_alignParentRight="true"
            android:contentDescription="清空密码"/>
    </RelativeLayout>
    <Button
        android:textSize="16sp"
        android:textColor="@color/yh_white"
        android:id="@+id/bn_btn_login"
        android:background="@drawable/yh_blue_selete_90"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="36dp"
        android:text="修改密码"
        android:layout_below="@+id/bn_rl_password"
        style="?android:attr/borderlessButtonStyle"/>
</RelativeLayout>
