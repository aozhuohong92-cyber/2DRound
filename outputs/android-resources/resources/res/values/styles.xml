<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="yh_base_dialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@color/yh_transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:padding">0dp</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <style name="yh_dim_dialog" parent="@style/yh_base_dialog">
        <item name="android:backgroundDimEnabled">true</item>
    </style>
    <style name="yh_fullscreen_dialog" parent="@style/yh_base_dialog">
        <item name="android:windowIsFloating">false</item>
    </style>
    <style name="bn_animate_dialog_horizontal" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/bn_dialog_enter_h</item>
        <item name="android:windowExitAnimation">@anim/bn_dialog_exit_h</item>
    </style>
    <style name="bn_animate_dialog_vertical" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/bn_dialog_enter_v</item>
        <item name="android:windowExitAnimation">@anim/bn_dialog_exit_v</item>
    </style>
    <style name="yh_tips_dialog_anim" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/bn_tips_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/bn_tips_dialog_exit</item>
    </style>
</resources>
