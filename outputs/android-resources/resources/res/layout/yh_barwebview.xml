<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/yh_rl_title"
        android:background="@color/yh_white"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <ImageView
            android:id="@+id/yh_iv_back"
            android:padding="12dp"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/yh_back"
            android:contentDescription="返回"/>
        <ImageView
            android:id="@+id/yh_iv_empty"
            android:padding="12dp"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_toRightOf="@+id/yh_iv_back"
            android:contentDescription="为了让标题居中的占位view"/>
        <ImageView
            android:id="@+id/yh_iv_close"
            android:padding="12dp"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/yh_close"
            android:layout_alignParentRight="true"
            android:contentDescription="关闭"/>
        <ImageView
            android:id="@+id/yh_iv_update"
            android:padding="12dp"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/yh_refresh"
            android:layout_toLeftOf="@+id/yh_iv_close"
            android:contentDescription="更新"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/yh_text_gray"
            android:gravity="center"
            android:id="@+id/yh_tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/yh_iv_update"
            android:layout_toRightOf="@+id/yh_iv_empty"
            android:layout_centerInParent="true"/>
        <View
            android:background="@color/yh_text_gray"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/yh_fl_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/yh_rl_title"/>
</RelativeLayout>
