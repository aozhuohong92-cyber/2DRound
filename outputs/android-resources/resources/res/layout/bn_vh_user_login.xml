<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/bn_iv_phone"
        android:padding="6dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/bn_user"
        android:layout_centerVertical="true"
        android:contentDescription="账号类型"/>
    <ImageView
        android:id="@+id/yh_iv_close"
        android:padding="12dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/yh_close"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:contentDescription="账号清除"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_toLeftOf="@+id/yh_iv_close"
        android:layout_toRightOf="@+id/bn_iv_phone"
        android:layout_centerVertical="true">
        <TextView
            android:textColor="@color/yh_black"
            android:gravity="center_vertical"
            android:id="@+id/bn_edt_username"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/yh_text_gray"
            android:ellipsize="end"
            android:id="@+id/bn_tv_cdata"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/yh_text_gray"
            android:ellipsize="end"
            android:id="@+id/bn_tv_crole"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
</RelativeLayout>
