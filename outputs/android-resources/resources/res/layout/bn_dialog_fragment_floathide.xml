<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@color/yh_light_black"
        android:padding="10dp"
        android:layout_width="320dp"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/yh_white"
            android:gravity="center"
            android:id="@+id/yh_tv_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="翻一翻可以显示/隐藏哦！"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/bn_iv_gif"
            android:layout_width="260dp"
            android:layout_height="140dp"
            android:src="@drawable/bn_float_hide"
            android:scaleType="fitXY"
            android:layout_below="@+id/yh_tv_hint"
            android:layout_centerHorizontal="true"
            android:contentDescription="icon"/>
        <Button
            android:textColor="@color/yh_white"
            android:id="@+id/yh_btn_close"
            android:background="@drawable/yh_blue_selete"
            android:layout_width="145dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:text="取消"
            android:layout_below="@+id/bn_iv_gif"/>
        <Button
            android:textColor="@color/yh_black"
            android:id="@+id/bn_btn_dismiss"
            android:background="@drawable/yh_gray_selete"
            android:layout_width="145dp"
            android:layout_height="40dp"
            android:text="隐藏"
            android:layout_alignTop="@+id/yh_btn_close"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</FrameLayout>
