<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="12dp"
    android:layout_width="350dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/yh_iv_back"
        android:padding="12dp"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/yh_back"
        android:contentDescription="返回"/>
    <ImageView
        android:id="@+id/yh_iv_close"
        android:padding="12dp"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/yh_close"
        android:layout_alignParentRight="true"
        android:contentDescription="关闭"/>
    <com.ibingniao.sdk.ui.widget.BnTitleLayout
        android:id="@+id/bn_tl_title"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="36dp"
        android:layout_marginRight="36dp"/>
    <com.ibingniao.sdk.ui.widget.BnViewPager
        android:id="@+id/bn_vp_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="28dp"
        android:layout_marginRight="28dp"
        android:layout_below="@+id/bn_tl_title"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="36dp"
        android:layout_below="@+id/bn_vp_content">
        <CheckBox
            android:id="@+id/bn_cb"
            android:background="@drawable/bn_check_login"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:button="@null"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/yh_text_gray"
            android:id="@+id/bn_tv_agreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="用户协议"
            android:layout_toRightOf="@+id/bn_cb"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/yh_blue"
            android:id="@+id/bn_tv_forget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="忘记密码"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</RelativeLayout>
