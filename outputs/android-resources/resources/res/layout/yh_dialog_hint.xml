<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/yh_activity_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/yh_black"
            android:gravity="center"
            android:id="@+id/yh_tv_content"
            android:layout_width="match_parent"
            android:layout_height="100dp"/>
        <View
            android:id="@+id/yh_v_center"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_below="@+id/yh_tv_content"
            android:layout_centerHorizontal="true"/>
        <Button
            android:textColor="@color/yh_white"
            android:gravity="center"
            android:id="@+id/yh_btn_left"
            android:background="@drawable/yh_blue_selete"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_toLeftOf="@+id/yh_v_center"
            android:layout_below="@+id/yh_tv_content"/>
        <Button
            android:textColor="@color/yh_black"
            android:gravity="center"
            android:id="@+id/yh_btn_right"
            android:background="@drawable/yh_gray_selete"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/yh_v_center"
            android:layout_alignTop="@+id/yh_btn_left"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</RelativeLayout>
