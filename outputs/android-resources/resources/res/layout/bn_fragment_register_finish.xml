<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/bn_rl_content"
    android:background="@drawable/yh_activity_container"
    android:padding="12dp"
    android:layout_width="350dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/yh_light_black"
        android:id="@+id/bn_tv_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="账号："/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/yh_light_black"
        android:id="@+id/bn_tv_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="密码："
        android:layout_below="@+id/bn_tv_username"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/yh_blue"
        android:id="@+id/bn_tv_hint_one"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="注册成功"
        android:layout_below="@+id/bn_tv_password"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/yh_blue"
        android:id="@+id/bn_tv_hint_two"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/bn_tv_hint_one"
        android:layout_centerHorizontal="true"/>
    <Button
        android:textSize="18sp"
        android:textColor="@color/yh_white"
        android:gravity="center"
        android:id="@+id/yh_btn_sure"
        android:background="@drawable/yh_blue_selete_90"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:text="进入游戏"
        android:layout_below="@+id/bn_tv_hint_two"/>
</RelativeLayout>
