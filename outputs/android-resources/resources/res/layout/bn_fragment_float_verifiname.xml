<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/yh_black"
                android:id="@+id/bn_tv_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:text="您的游戏账号："
                android:textIsSelectable="true"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/yh_text_gray"
                android:id="@+id/bn_tv_hint_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="12dp"
                android:text="真实姓名，如：张三"
                android:layout_below="@+id/bn_tv_username"
                android:textIsSelectable="true"/>
            <RelativeLayout
                android:id="@+id/bn_rl_name"
                android:background="@drawable/yh_gray_background"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="12dp"
                android:layout_below="@+id/bn_tv_hint_name">
                <ImageView
                    android:id="@+id/bn_iv_name"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/bn_float_peoper"
                    android:layout_centerVertical="true"
                    android:contentDescription="姓名图标"/>
                <ImageView
                    android:id="@+id/bn_iv_name_clear"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/yh_edit_clear"
                    android:layout_alignParentRight="true"
                    android:contentDescription="姓名清空"/>
                <EditText
                    android:textSize="16sp"
                    android:textColor="@color/yh_black"
                    android:id="@+id/bn_edt_name"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:hint="请输入您的真实姓名"
                    android:maxLines="1"
                    android:layout_toLeftOf="@+id/bn_iv_name_clear"
                    android:layout_toRightOf="@+id/bn_iv_name"
                    android:layout_centerVertical="true"
                    android:inputType="text"
                    android:textCursorDrawable="@drawable/yh_cursor_color"/>
            </RelativeLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/yh_text_gray"
                android:id="@+id/bn_tv_hint_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="12dp"
                android:text="真实身份证号，如440106198101010155"
                android:layout_below="@+id/bn_rl_name"
                android:textIsSelectable="true"/>
            <RelativeLayout
                android:id="@+id/bn_rl_code"
                android:background="@drawable/yh_gray_background"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="12dp"
                android:layout_below="@+id/bn_tv_hint_code">
                <ImageView
                    android:id="@+id/bn_iv_code"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/bn_float_authentication"
                    android:layout_centerVertical="true"
                    android:contentDescription="身份证图标"/>
                <ImageView
                    android:id="@+id/bn_iv_code_clear"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/yh_edit_clear"
                    android:layout_alignParentRight="true"
                    android:contentDescription="身份证清空"/>
                <EditText
                    android:textSize="16sp"
                    android:textColor="@color/yh_black"
                    android:id="@+id/bn_edt_code"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:hint="请输入您的身份证号码"
                    android:maxLines="1"
                    android:layout_toLeftOf="@+id/bn_iv_code_clear"
                    android:layout_toRightOf="@+id/bn_iv_code"
                    android:layout_centerVertical="true"
                    android:inputType="text"
                    android:textCursorDrawable="@drawable/yh_cursor_color"/>
            </RelativeLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/bn_hint_red"
                android:id="@+id/bn_tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="12dp"
                android:text="为了保障您的个人权益和账号安全，网游用户需要使用有效身份证件进行实名认证，未实名验证的用户会受到充值功能和游戏时长限制。"
                android:layout_below="@+id/bn_rl_code"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/bn_tv_title">
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/yh_black"
                    android:id="@+id/yh_btn_close"
                    android:background="@drawable/yh_gray_selete"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="12dp"
                    android:text="取 消"
                    android:layout_weight="1"/>
                <Button
                    android:textSize="16sp"
                    android:textColor="@color/yh_white"
                    android:id="@+id/yh_btn_sure"
                    android:background="@drawable/yh_blue_selete"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="12dp"
                    android:text="确 认"
                    android:layout_weight="1"/>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
</LinearLayout>
