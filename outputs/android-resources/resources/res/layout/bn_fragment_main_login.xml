<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingBottom="12dp"
    android:layout_width="350dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/yh_iv_back"
        android:padding="12dp"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/yh_back"
        android:contentDescription="返回"/>
    <ImageView
        android:id="@+id/yh_iv_close"
        android:padding="12dp"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/yh_close"
        android:layout_alignParentRight="true"
        android:contentDescription="关闭"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/yh_light_black"
        android:gravity="center"
        android:id="@+id/bn_tv_hint_chose"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:text="选择登录方式"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_below="@+id/bn_tv_hint_chose">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bn_ll_fast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:gravity="center"
                android:layout_gravity="center"
                android:padding="6dp"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/bn_fast"
                android:contentDescription="快速游戏"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/yh_light_black"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="快速游戏"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bn_ll_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:gravity="center"
                android:layout_gravity="center"
                android:padding="6dp"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/bn_phone"
                android:contentDescription="手机登录"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/yh_light_black"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="手机登录"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bn_ll_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:gravity="center"
                android:layout_gravity="center"
                android:padding="6dp"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/bn_user"
                android:contentDescription="账号登录"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/yh_light_black"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="账号登录"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
