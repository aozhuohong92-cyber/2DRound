<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/yh_dialog_90"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:padding="10dp"
        android:layout_width="320dp"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:contentDescription="icon"/>
        <FrameLayout
            android:id="@+id/yh_fl_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/bn_iv_advertisement"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:scaleType="fitXY"
                android:contentDescription="退出图片"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/yh_black"
                android:gravity="center"
                android:id="@+id/yh_tv_hint"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:text="是否退出游戏？"/>
        </FrameLayout>
        <Button
            android:textColor="@color/yh_white"
            android:gravity="center"
            android:id="@+id/yh_btn_left"
            android:background="@drawable/yh_blue_selete"
            android:layout_width="140dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:text="退出游戏"
            android:layout_below="@+id/yh_fl_content"/>
        <Button
            android:textColor="@color/yh_black"
            android:gravity="center"
            android:id="@+id/yh_btn_right"
            android:background="@drawable/yh_gray_selete"
            android:layout_width="140dp"
            android:layout_height="40dp"
            android:text="继续游戏"
            android:layout_alignTop="@+id/yh_btn_left"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</FrameLayout>
