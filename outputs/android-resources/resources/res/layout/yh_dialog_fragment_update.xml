<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/yh_activity_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="320dp"
        android:layout_height="260dp">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/yh_white"
            android:gravity="center"
            android:id="@+id/yh_tv_title"
            android:background="@color/yh_blue"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:text="更新"
            android:layout_centerHorizontal="true"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/yh_white"
            android:id="@+id/yh_btn_update"
            android:background="@drawable/yh_blue_selete"
            android:layout_width="142dp"
            android:layout_height="40dp"
            android:layout_marginLeft="12dp"
            android:layout_marginBottom="12dp"
            android:text="立即更新"
            android:layout_alignParentBottom="true"
            style="?android:attr/borderlessButtonStyle"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/yh_black"
            android:id="@+id/yh_btn_close"
            android:background="@drawable/yh_gray_selete"
            android:layout_width="142dp"
            android:layout_height="40dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"
            android:text="下次再说"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            style="?android:attr/borderlessButtonStyle"/>
        <FrameLayout
            android:id="@+id/yh_fl_web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="6dp"
            android:layout_above="@+id/yh_btn_update"
            android:layout_below="@+id/yh_tv_title"/>
    </RelativeLayout>
</FrameLayout>
