<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/yh_loading_background"
    android:padding="12dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ProgressBar
        android:id="@+id/yh_pb_content"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:indeterminateDrawable="@drawable/yh_load_anim_rotate"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/yh_black"
        android:id="@+id/yh_tv_content"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/yh_pb_content"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
