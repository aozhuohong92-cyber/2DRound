<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingBottom="16dp"
    android:layout_width="350dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/yh_iv_back"
        android:padding="12dp"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/yh_back"
        android:contentDescription="返回"/>
    <ImageView
        android:id="@+id/yh_iv_close"
        android:padding="12dp"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/yh_close"
        android:layout_alignParentRight="true"
        android:contentDescription="关闭"/>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/yh_text_gray"
        android:id="@+id/bn_tv_hint_one"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="请填写手机短信验证码"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bn_ll_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_below="@+id/bn_tv_hint_one"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/yh_text_gray"
            android:layout_gravity="center_vertical"
            android:id="@+id/bn_tv_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/yh_text_gray"
            android:layout_gravity="center_vertical"
            android:id="@+id/bn_tv_time"
            android:background="@drawable/bn_textgray_white_90"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="60s"/>
    </LinearLayout>
    <com.ibingniao.sdk.ui.widget.VerifyView
        android:id="@+id/bn_verify_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="36dp"
        android:layout_below="@+id/bn_ll_time"
        android:layout_centerHorizontal="true"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/yh_white"
        android:id="@+id/bn_btn_login"
        android:background="@drawable/yh_blue_selete_90"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="36dp"
        android:text="登 录"
        android:layout_below="@+id/bn_verify_view"
        style="?android:attr/borderlessButtonStyle"/>
</RelativeLayout>
