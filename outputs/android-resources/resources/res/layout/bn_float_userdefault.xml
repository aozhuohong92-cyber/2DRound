<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/bn_rl_username"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/bn_iv_header"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="15dp"
            android:src="@drawable/bn_title_bar_logo"
            android:contentDescription="账号"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/yh_black"
            android:id="@+id/bn_tv_username_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="游戏账号"
            android:layout_toRightOf="@+id/bn_iv_header"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/yh_black"
            android:id="@+id/bn_tv_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/bn_iv_header"
            android:layout_below="@+id/bn_tv_username_hint"
            android:textIsSelectable="true"/>
        <TextView
            android:textColor="@drawable/yh_textview_selete"
            android:id="@+id/bn_tv_login_out"
            android:background="@drawable/yh_blue_stroke_selete"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:text="退出登录"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/bn_v1"
        android:background="@color/yh_gainsboro"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/bn_rl_username"/>
    <RelativeLayout
        android:id="@+id/bn_rl_forget"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/bn_v1">
        <ImageView
            android:id="@+id/bn_iv_header_forget"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="20dp"
            android:src="@drawable/bn_float_forget"
            android:contentDescription="修改密码"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/yh_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="修改密码"
            android:layout_toRightOf="@+id/bn_iv_header_forget"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/bn_iv_right_forget"
            android:padding="6dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/yh_right"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:contentDescription="icon"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/yh_black"
            android:id="@+id/bn_tv_right_forget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/bn_iv_right_forget"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/bn_v2"
        android:background="@color/yh_gainsboro"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/bn_rl_forget"/>
    <RelativeLayout
        android:id="@+id/bn_rl_phone"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/bn_v2">
        <ImageView
            android:id="@+id/bn_iv_header_phone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="20dp"
            android:src="@drawable/bn_float_bindingphone"
            android:contentDescription="绑定手机"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/yh_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="绑定手机"
            android:layout_toRightOf="@+id/bn_iv_header_phone"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/bn_iv_right_phone"
            android:padding="6dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/yh_right"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:contentDescription="icon"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/yh_black"
            android:id="@+id/bn_tv_right_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/bn_iv_right_phone"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/bn_v3"
        android:background="@color/yh_gainsboro"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/bn_rl_phone"/>
    <RelativeLayout
        android:id="@+id/bn_rl_authentication"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/bn_v3">
        <ImageView
            android:id="@+id/bn_iv_header_authentication"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="20dp"
            android:src="@drawable/bn_float_authentication"
            android:contentDescription="实名认证"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/yh_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="实名认证"
            android:layout_toRightOf="@+id/bn_iv_header_authentication"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/bn_iv_right_authentication"
            android:padding="6dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/yh_right"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:contentDescription="icon"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/yh_black"
            android:id="@+id/bn_tv_right_authentication"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/bn_iv_right_authentication"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <View
        android:background="@color/yh_gainsboro"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/bn_rl_authentication"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/yh_light_black"
        android:id="@+id/bn_tv_version"
        android:background="@drawable/bn_gray_circular"
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="版本："
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
