<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/bn_iv_header"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_centerVertical="true"
        android:contentDescription="icon"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/yh_black"
        android:id="@+id/yh_tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_toRightOf="@+id/bn_iv_header"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/yh_text_gray"
        android:id="@+id/yh_tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/yh_tv_title"
        android:layout_alignLeft="@+id/yh_tv_title"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/yh_text_gray"
        android:id="@+id/bn_tv_contact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/yh_tv_hint"
        android:layout_alignLeft="@+id/yh_tv_hint"/>
    <Button
        android:textSize="12sp"
        android:textColor="@drawable/yh_textview_selete"
        android:id="@+id/bn_btn_contact"
        android:background="@drawable/yh_blue_stroke_selete"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
