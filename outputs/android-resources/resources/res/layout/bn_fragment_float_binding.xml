<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/yh_black"
                android:id="@+id/bn_tv_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="您的游戏账号为："
                android:textIsSelectable="true"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/bn_hint_red"
                android:id="@+id/yh_tv_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="为了您的账号安全，请绑定手机号码"
                android:layout_below="@+id/bn_tv_username"/>
            <RelativeLayout
                android:id="@+id/bn_rl_phone"
                android:background="@drawable/yh_gray_background"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_below="@+id/yh_tv_hint">
                <ImageView
                    android:id="@+id/bn_iv_phone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/bn_float_user"
                    android:layout_centerVertical="true"
                    android:contentDescription="账号图标"/>
                <ImageView
                    android:id="@+id/bn_iv_clear"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/yh_edit_clear"
                    android:layout_alignParentRight="true"
                    android:contentDescription="清空"/>
                <EditText
                    android:textSize="16sp"
                    android:textColor="@color/yh_black"
                    android:id="@+id/bn_edt_phone"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:hint="请输入手机号"
                    android:maxLines="1"
                    android:layout_toLeftOf="@+id/bn_iv_clear"
                    android:layout_toRightOf="@+id/bn_iv_phone"
                    android:layout_centerVertical="true"
                    android:inputType="number"
                    android:textCursorDrawable="@drawable/yh_cursor_color"/>
            </RelativeLayout>
            <Button
                android:textSize="16sp"
                android:textColor="@color/yh_white"
                android:id="@+id/bn_btn_code"
                android:background="@drawable/bn_blue_chestnut"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:minWidth="50dp"
                android:text="获取验证码"
                android:layout_below="@+id/bn_rl_phone"
                android:layout_alignParentRight="true"/>
            <RelativeLayout
                android:id="@+id/bn_rl_code"
                android:background="@drawable/yh_gray_background"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginRight="12dp"
                android:layout_toLeftOf="@+id/bn_btn_code"
                android:layout_below="@+id/bn_rl_phone">
                <ImageView
                    android:id="@+id/bn_iv_code"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/bn_float_shield"
                    android:layout_centerVertical="true"
                    android:contentDescription="验证码图标"/>
                <EditText
                    android:textSize="16sp"
                    android:textColor="@color/yh_black"
                    android:id="@+id/bn_edt_code"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:hint="请输入验证码"
                    android:maxLines="1"
                    android:layout_toRightOf="@+id/bn_iv_code"
                    android:layout_centerVertical="true"
                    android:inputType="text"
                    android:textCursorDrawable="@drawable/yh_cursor_color"/>
            </RelativeLayout>
            <Button
                android:textSize="16sp"
                android:textColor="@color/yh_white"
                android:id="@+id/yh_btn_sure"
                android:background="@drawable/yh_blue_selete"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:text="确 认"
                android:layout_below="@+id/bn_rl_code"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
    </ScrollView>
</LinearLayout>
