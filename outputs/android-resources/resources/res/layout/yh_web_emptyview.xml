<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/yh_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/yh_black"
        android:id="@+id/yh_tv_empty_hide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="网页正在加载中，请稍等"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/yh_iv_empty_pic"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="6dp"
        android:src="@drawable/yh_web_loading_error"
        android:layout_above="@+id/yh_tv_empty_hide"
        android:layout_centerHorizontal="true"
        android:contentDescription="加载错误"/>
    <ProgressBar
        android:id="@+id/yh_pb_empty_load"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="12dp"
        android:layout_above="@+id/yh_tv_empty_hide"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/yh_blue"
        android:id="@+id/yh_tv_empty_reload"
        android:background="@drawable/yh_blue_white_90"
        android:paddingLeft="6dp"
        android:paddingTop="3dp"
        android:paddingRight="6dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="重新加载"
        android:layout_below="@+id/yh_tv_empty_hide"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
