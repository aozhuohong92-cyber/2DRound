<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/yh_rl_title"
        android:background="@color/yh_blue"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/yh_white"
            android:id="@+id/yh_tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="客服"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/yh_iv_close"
            android:padding="12dp"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/yh_close"
            android:tint="@color/yh_white"
            android:layout_alignParentRight="true"
            android:contentDescription="关闭"/>
    </RelativeLayout>
    <ListView
        android:id="@+id/bn_rv_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/yh_rl_title"/>
</RelativeLayout>
