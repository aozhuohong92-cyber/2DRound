<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/yh_black"
                android:id="@+id/bn_tv_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="您的游戏账号："
                android:textIsSelectable="true"/>
            <RelativeLayout
                android:background="@drawable/yh_gray_background"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <ImageView
                    android:id="@+id/bn_iv_password"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/bn_float_user"
                    android:layout_centerVertical="true"
                    android:contentDescription="密码图标"/>
                <ImageView
                    android:id="@+id/bn_iv_pw_clear"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/yh_edit_clear"
                    android:layout_alignParentRight="true"
                    android:contentDescription="密码清空"/>
                <EditText
                    android:textSize="16sp"
                    android:textColor="@color/yh_black"
                    android:id="@+id/bn_edt_password"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:hint="请输入您的密码"
                    android:maxLines="1"
                    android:layout_toLeftOf="@+id/bn_iv_pw_clear"
                    android:layout_toRightOf="@+id/bn_iv_password"
                    android:layout_centerVertical="true"
                    android:inputType="text"
                    android:textCursorDrawable="@drawable/yh_cursor_color"/>
            </RelativeLayout>
            <RelativeLayout
                android:background="@drawable/yh_gray_background"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <ImageView
                    android:id="@+id/bn_iv_new_password"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/bn_float_lock"
                    android:layout_centerVertical="true"
                    android:contentDescription="新密码图标"/>
                <ImageView
                    android:id="@+id/bn_iv_npw_clear"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/yh_edit_clear"
                    android:layout_alignParentRight="true"
                    android:contentDescription="新密码清空"/>
                <EditText
                    android:textSize="16sp"
                    android:textColor="@color/yh_black"
                    android:id="@+id/bn_edt_new_password"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:hint="请输入新密码（6-14位）"
                    android:maxLines="1"
                    android:layout_toLeftOf="@+id/bn_iv_npw_clear"
                    android:layout_toRightOf="@+id/bn_iv_new_password"
                    android:layout_centerVertical="true"
                    android:inputType="textPassword"
                    android:textCursorDrawable="@drawable/yh_cursor_color"/>
            </RelativeLayout>
            <RelativeLayout
                android:background="@drawable/yh_gray_background"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <ImageView
                    android:id="@+id/bn_iv_user_password"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/bn_float_shield"
                    android:layout_centerVertical="true"
                    android:contentDescription="再次新密码图标"/>
                <ImageView
                    android:id="@+id/bn_iv_upw_clear"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/yh_edit_clear"
                    android:layout_alignParentRight="true"
                    android:contentDescription="再次新密码清空"/>
                <EditText
                    android:textSize="16sp"
                    android:textColor="@color/yh_black"
                    android:id="@+id/bn_edt_suer_password"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:hint="请再次输入新密码（6-14位）"
                    android:maxLines="1"
                    android:layout_toLeftOf="@+id/bn_iv_upw_clear"
                    android:layout_toRightOf="@+id/bn_iv_user_password"
                    android:layout_centerVertical="true"
                    android:inputType="textPassword"
                    android:textCursorDrawable="@drawable/yh_cursor_color"/>
            </RelativeLayout>
            <Button
                android:textSize="16sp"
                android:textColor="@color/yh_white"
                android:id="@+id/yh_btn_sure"
                android:background="@drawable/yh_blue_selete"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:text="确 认"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
