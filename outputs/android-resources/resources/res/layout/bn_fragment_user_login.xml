<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="12dp"
    android:paddingTop="28dp"
    android:paddingRight="12dp"
    android:paddingBottom="12dp"
    android:layout_width="350dp"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/bn_rl_username"
        android:background="@drawable/bn_black_white_90"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/bn_iv_phone"
            android:padding="6dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/bn_phone"
            android:contentDescription="账号类型"/>
        <ImageView
            android:id="@+id/bn_iv_pull"
            android:padding="6dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/bn_down"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:contentDescription="账号下拉"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/yh_black"
            android:id="@+id/bn_edt_username"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:maxLines="1"
            android:layout_toLeftOf="@+id/bn_iv_pull"
            android:layout_toRightOf="@+id/bn_iv_phone"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <Button
        android:textSize="16sp"
        android:textColor="@color/yh_white"
        android:id="@+id/bn_btn_login"
        android:background="@drawable/yh_blue_selete_90"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="14dp"
        android:text="登 录"
        android:layout_below="@+id/bn_rl_username"
        style="?android:attr/borderlessButtonStyle"/>
    <View
        android:id="@+id/bn_v_line"
        android:background="@color/yh_light_black"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="18dp"
        android:layout_below="@+id/bn_btn_login"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/yh_blue"
        android:layout_gravity="center_horizontal"
        android:id="@+id/bn_tv_other"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="使用其他账号登录&gt;"
        android:layout_below="@+id/bn_v_line"
        android:layout_centerHorizontal="true"/>
    <ListView
        android:id="@+id/bn_rv_history"
        android:background="@drawable/bn_black_white_90"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:cacheColorHint="#00000000"
        android:divider="@color/yh_light_black"
        android:dividerHeight="1dp"
        android:layout_below="@+id/bn_rl_username"
        android:overScrollMode="never"/>
</RelativeLayout>
