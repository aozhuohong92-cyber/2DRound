<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/yh_activity_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/bn_rl_content"
        android:paddingBottom="12dp"
        android:layout_width="350dp"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/yh_black"
            android:gravity="center"
            android:id="@+id/yh_tv_title"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="用户协议"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/yh_iv_close"
            android:padding="6dp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/yh_close"
            android:layout_alignParentRight="true"
            android:contentDescription="关闭"/>
        <ScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="36dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="36dp"
            android:layout_below="@+id/yh_tv_title">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/yh_black"
                    android:id="@+id/yh_tv_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
        </ScrollView>
    </RelativeLayout>
</FrameLayout>
