<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/yh_activity_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:padding="36dp"
        android:layout_width="320dp"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/yh_blue"
            android:id="@+id/yh_tv_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在更新"
            android:layout_centerHorizontal="true"/>
        <ProgressBar
            android:id="@+id/yh_pb_content"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:progressDrawable="@drawable/yh_progress_dl"
            android:layout_below="@+id/yh_tv_hint"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/yh_black"
            android:id="@+id/yh_tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_below="@+id/yh_pb_content"
            android:layout_alignParentRight="true"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/yh_white"
            android:id="@+id/yh_btn_stop"
            android:background="@drawable/yh_round_blue_button"
            android:layout_width="118dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:text="暂停"
            android:layout_below="@+id/yh_tv_progress"
            style="?android:attr/borderlessButtonStyle"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/yh_white"
            android:id="@+id/yh_btn_close"
            android:background="@drawable/yh_round_blue_button"
            android:layout_width="118dp"
            android:layout_height="40dp"
            android:text="取消"
            android:layout_alignTop="@+id/yh_btn_stop"
            android:layout_alignParentRight="true"
            style="?android:attr/borderlessButtonStyle"/>
    </RelativeLayout>
</FrameLayout>
