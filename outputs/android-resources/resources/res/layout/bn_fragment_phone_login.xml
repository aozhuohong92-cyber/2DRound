<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingBottom="12dp"
    android:layout_width="350dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/yh_iv_back"
        android:padding="12dp"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/yh_back"
        android:contentDescription="返回"/>
    <ImageView
        android:id="@+id/yh_iv_close"
        android:padding="12dp"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/yh_close"
        android:layout_alignParentRight="true"
        android:contentDescription="关闭"/>
    <RelativeLayout
        android:id="@+id/bn_rl_phone"
        android:background="@color/yh_gainsboro"
        android:padding="1dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="36dp"
        android:layout_marginRight="36dp"
        android:layout_below="@+id/yh_iv_back">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/yh_black"
            android:gravity="center"
            android:id="@+id/bn_tv_86"
            android:background="@color/yh_white"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="86"/>
        <ImageView
            android:id="@+id/bn_iv_clear"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/yh_edit_clear"
            android:layout_alignParentRight="true"
            android:contentDescription="清空"/>
        <EditText
            android:textSize="16sp"
            android:textColor="@color/yh_black"
            android:id="@+id/bn_edt_phone"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:hint="请输入手机号"
            android:maxLines="1"
            android:layout_toLeftOf="@+id/bn_iv_clear"
            android:layout_toRightOf="@+id/bn_tv_86"
            android:layout_centerVertical="true"
            android:inputType="number"
            android:textCursorDrawable="@drawable/yh_cursor_color"/>
    </RelativeLayout>
    <Button
        android:textSize="16sp"
        android:textColor="@color/yh_white"
        android:id="@+id/bn_btn_next"
        android:background="@drawable/yh_blue_selete_90"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="36dp"
        android:text="下一步"
        android:layout_below="@+id/bn_rl_phone"
        style="?android:attr/borderlessButtonStyle"/>
    <RelativeLayout
        android:id="@+id/bn_rl_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="36dp"
        android:layout_below="@+id/bn_btn_next">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/yh_gainsboro"
            android:id="@+id/bn_tv_login_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="其它登录方式"
            android:layout_centerInParent="true"/>
        <View
            android:background="@color/yh_gainsboro"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginRight="6dp"
            android:layout_toLeftOf="@+id/bn_tv_login_hint"
            android:layout_centerVertical="true"/>
        <View
            android:background="@color/yh_gainsboro"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="6dp"
            android:layout_toRightOf="@+id/bn_tv_login_hint"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="36dp"
        android:layout_below="@+id/bn_rl_hint">
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/bn_rl_fast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/bn_iv_fast"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/bn_fast"
                android:contentDescription="快速游戏"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/yh_light_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 快速游戏"
                android:layout_toRightOf="@+id/bn_iv_fast"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <View
            android:background="@color/yh_gainsboro"
            android:layout_width="1dp"
            android:layout_height="36dp"/>
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/bn_rl_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/bn_iv_user"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/bn_user"
                android:contentDescription="账号登录"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/yh_light_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 账号登录"
                android:layout_toRightOf="@+id/bn_iv_user"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
